{
    "name": "Fluxo v8+ Browser Helper",
    "manifest_version": 3,
    "version": "1.4",
    "description": "Download files with Fluxo v8+",
    "action": {},
    "permissions": [
        "tabs",
        "cookies",
        "contextMenus",
        "menus",
        "activeTab",
        "webRequest",
        "webRequestBlocking"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "background": {
        "scripts": [
            "app/logger.js",
            "app/connector.js",
            "app/request-watcher.js",
            "app/app.js",
            "main.js"
        ]
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "fluxo-browser-helper@ashraaf97.github.io",
            "strict_min_version": "115.0"
        }
    }
}
