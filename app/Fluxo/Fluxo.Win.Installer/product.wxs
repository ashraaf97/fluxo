<?xml version="1.0" encoding="UTF-8"?>
<?define ProductVersion = "$(var.Version)"?>
<?define ProductUpgradeCode = "3E462F34-3D19-4247-AD64-1B74703555D6"?>
<!--
  Fluxo installer, WiX v5.

  PublishDir is passed on the command line (-d PublishDir=...) and points at a
  self-contained `dotnet publish` output, so the installed app carries its own
  .NET runtime and the machine needs no prerequisite.

  The UpgradeCode and the three shortcut component GUIDs are inherited from the
  original XDM installer and must not change, or upgrades over an existing
  install will break.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Fluxo"
           Codepage="1252"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="Fluxo"
           UpgradeCode="$(var.ProductUpgradeCode)"
           InstallerVersion="500"
           Compressed="yes"
           Scope="perMachine">

    <Upgrade Id="$(var.ProductUpgradeCode)">
      <UpgradeVersion Minimum="$(var.ProductVersion)" OnlyDetect="yes" Property="NEWERVERSIONDETECTED" />
      <UpgradeVersion Minimum="0.0.0" Maximum="$(var.ProductVersion)" IncludeMinimum="yes" IncludeMaximum="no" Property="OLDERVERSIONBEINGUPGRADED" />
    </Upgrade>

    <Launch Condition="NOT NEWERVERSIONDETECTED"
            Message="A newer or equal version of Fluxo is already installed." />

    <Launch Condition="Installed OR (VersionNT &gt; 602)"
            Message="Fluxo requires Windows 10 or later." />

    <!--
      Build with -d Silent=1 for the UI-less variant. Note that any MSI can also
      be installed quietly with `msiexec /qn`; this variant simply omits the
      wizard entirely.
    -->
<?ifndef Silent ?>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open Fluxo" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <WixVariable Id="WixUILicenseRtf" Value="gpl-3.0.rtf" />

    <UI>
      <ui:WixUI Id="WixUI_InstallDir" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchFluxo"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
<?endif ?>

    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallValidate" />
    </InstallExecuteSequence>

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Feature Id="ProductFeature" Title="Fluxo" Level="1">
      <ComponentGroupRef Id="PublishedFiles" />
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="ProgramShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <CustomAction Id="LaunchFluxo" Directory="INSTALLFOLDER"
                  ExeCommand='"[INSTALLFOLDER]fluxo-app.exe" --first-run'
                  Return="asyncNoWait" Impersonate="yes" />
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="Fluxo" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuSubFolder" Name="Fluxo" />
    </StandardDirectory>
  </Fragment>

  <!--
    Everything produced by `dotnet publish`. This replaces the old heat.exe
    harvest step and the generated net4.x.wxs files that used to be checked in.
  -->
  <Fragment>
    <ComponentGroup Id="PublishedFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="RegistryEntries" Guid="*">
        <RegistryKey Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run">
          <RegistryValue Type="string" Name="Fluxo" Value='"[INSTALLFOLDER]fluxo-app.exe" --background' />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="fluxo-app">
          <RegistryValue Type="string" Value="URL:Fluxo" />
          <RegistryValue Type="string" Name="URL Protocol" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="fluxo-app\shell\open\command">
          <RegistryValue Type="string" Value='"[INSTALLFOLDER]fluxo-app.exe" "%1"' />
        </RegistryKey>
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Icon Id="AppIcon" SourceFile="icon.ico" />
    <DirectoryRef Id="ProgramMenuSubFolder">
      <Component Id="StartMenuShortcut" Guid="4c5c4bce-2625-4aa0-8741-a5ab43168cef">
        <Shortcut Id="AppStartMenuShortcut" Name="Fluxo" Icon="AppIcon" WorkingDirectory="INSTALLFOLDER" Target="[INSTALLFOLDER]fluxo-app.exe" Advertise="no" />
        <RegistryValue Root="HKCU" Key="Software\Fluxo" Name="Installed1" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="ProgramMenuSubFolder" On="uninstall" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ProgramShortcut" Guid="4c5c4bce-2625-4aa0-8741-a5ab53168cef">
        <Shortcut Id="AppShortcut" Name="Fluxo" Icon="AppIcon" WorkingDirectory="INSTALLFOLDER" Target="[INSTALLFOLDER]fluxo-app.exe" Advertise="no" />
        <RegistryValue Root="HKLM" Key="Software\Fluxo" Name="Installed2" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="4c5c4bce-2625-4aa0-8741-a5ab53268cef">
        <Shortcut Id="AppDesktopShortcut" Name="Fluxo" Icon="AppIcon" WorkingDirectory="INSTALLFOLDER" Target="[INSTALLFOLDER]fluxo-app.exe" Advertise="no" />
        <RegistryValue Root="HKCU" Key="Software\Fluxo" Name="Installed3" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>
</Wix>
