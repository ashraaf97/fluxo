<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>Link</TrimMode>
    <AssemblyName>fluxo-app</AssemblyName>
    <RootNamespace>Fluxo.GtkUI</RootNamespace>
    <!--RuntimeIdentifier>linux-x64</RuntimeIdentifier-->
    <!--RuntimeIdentifier>win-x64</RuntimeIdentifier-->
    <!--RuntimeIdentifier>win-x86</RuntimeIdentifier-->
    <!--<Platforms>AnyCPU;x86</Platforms>-->
    <!--<TrimMode>CopyUsed</TrimMode>-->
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!--<ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>-->
    <DefineConstants>LINUX</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GtkSharp" Version="3.24.24.95" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="glade\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="svg-icons\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="images\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Lang\*.*" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" LinkBase="Lang\" />
    <None Remove="images\extension-folder.jpg" />
    <Content Include="..\fluxo-logo.svg" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <!--
    Atk/Cairo/Gdk/Gio/GLib/Pango Sharp all arrive transitively via the GtkSharp
    package reference above, so they are not listed explicitly here. They used to
    be <Reference> items pointing at a hard coded D:\gtksharp build output, which
    only ever resolved on the original author's machine.
  -->

  <ItemGroup>
    <None Update="source_pkg.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="fluxo-logo-512.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="..\Fluxo.Core\Fluxo.Core.projitems" Label="Shared" />

  <Import Project="..\Fluxo.Messaging\Fluxo.Messaging.projitems" Label="Shared" />

  <Import Project="..\Fluxo.Compatibility\Fluxo.Compatibility.projitems" Label="Shared" />


  <ItemGroup>
    <Content Include="..\chrome-extension\**" CopyToOutputDirectory="Always" LinkBase="chrome-extension\" />
  </ItemGroup>


  <!--<ItemGroup>
	  <Content Update="glade\download-complete-window.glade">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>-->


</Project>
