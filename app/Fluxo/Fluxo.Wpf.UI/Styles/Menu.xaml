<!--
    ContextMenu and MenuItem.

    There was previously no MenuItem style at all, only a ContextMenu container
    template. Menu items therefore rendered with the stock Aero2 style - black text
    on the dark popup - which is why callers hand-set Foreground on every single
    MenuItem. With a real style in place those per-item overrides can be deleted.

    Popups are not in the owning window's visual tree, so Foreground is set here
    explicitly rather than inherited from the Window style.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--#region ContextMenu -->
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForecolor}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border x:Name="Border"
                            CornerRadius="{DynamicResource RadiusLg}"
                            Background="{DynamicResource SurfaceElevated}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            Padding="4"
                            Margin="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2"
                                              Direction="270" Opacity="0.3" Color="Black"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region Separator -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="Background" Value="{DynamicResource BorderSubtle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Background="{TemplateBinding Background}" Height="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region MenuItem -->
    <ControlTemplate x:Key="FluxoSubmenuItem" TargetType="{x:Type MenuItem}">
        <Border x:Name="Bd"
                CornerRadius="{DynamicResource RadiusSm}"
                Background="Transparent"
                Padding="{TemplateBinding Padding}"
                Margin="0,1"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIcon"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon"
                                  Grid.Column="0"
                                  ContentSource="Icon"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>

                <Path x:Name="Check"
                      Grid.Column="0"
                      Visibility="Collapsed"
                      Width="12" Height="12"
                      Margin="0,0,8,0"
                      Stretch="Uniform"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Stroke="{DynamicResource AccentBrush}"
                      Data="M 3,8 L 6.5,11.5 L 13,4"
                      VerticalAlignment="Center"/>

                <ContentPresenter Grid.Column="1"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="{TemplateBinding InputGestureText}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiary}"/>

                <Path x:Name="SubArrow"
                      Grid.Column="2"
                      Visibility="Collapsed"
                      Width="6" Height="10"
                      Margin="16,0,0,0"
                      Stretch="Uniform"
                      Fill="{DynamicResource TextSecondary}"
                      Data="M 0 0 L 5 5 L 0 10 Z"
                      VerticalAlignment="Center"/>

                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Right"
                       PopupAnimation="Fade">
                    <Border CornerRadius="{DynamicResource RadiusLg}"
                            Background="{DynamicResource SurfaceElevated}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            Padding="4"
                            Margin="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2"
                                              Direction="270" Opacity="0.3" Color="Black"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter TargetName="SubArrow" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter TargetName="SubArrow" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsCheckable" Value="True">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{DynamicResource SurfaceHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForecolor}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Template" Value="{StaticResource FluxoSubmenuItem}"/>
    </Style>
    <!--#endregion-->

</ResourceDictionary>
