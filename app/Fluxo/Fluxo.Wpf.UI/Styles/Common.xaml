<!--
    Design constants shared by every control template, plus the root Window style.

    Colours live in Themes/Tokens.*.xaml; the geometry/typography constants here
    are theme-independent and so are defined once.

    Everything below references colours with DynamicResource, never StaticResource.
    That is what lets ThemeManager swap the token dictionary at runtime. (UI strings
    are a separate matter - those stay StaticResource, see TranslationResourceDictionary.)

    Note there is deliberately NO implicit TextBlock Foreground setter. An explicit
    setter would beat the inherited TextElement.Foreground and stop selected list
    rows from recolouring their text. Instead the Window style below seeds the
    inheritance chain, and popups - which live outside the window's visual tree -
    set Foreground in their own styles.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:core="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--#region Radius -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
    <!--#endregion-->

    <!--#region Typography
         Segoe UI Variable is the Windows 11 UI face; Segoe UI is the Win10 fallback.
    -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

    <core:Double x:Key="FontSizeCaption">11</core:Double>
    <core:Double x:Key="FontSizeBody">12</core:Double>
    <core:Double x:Key="FontSizeBodyLarge">13</core:Double>
    <core:Double x:Key="FontSizeSubtitle">14</core:Double>
    <core:Double x:Key="FontSizeTitle">18</core:Double>
    <core:Double x:Key="FontSizeTitleLarge">24</core:Double>
    <!--#endregion-->

    <!--#region Metrics -->
    <core:Double x:Key="ControlHeight">32</core:Double>
    <core:Double x:Key="ControlHeightSmall">26</core:Double>
    <core:Double x:Key="RowHeight">38</core:Double>
    <core:Double x:Key="IconSize">16</core:Double>

    <Thickness x:Key="ControlPadding">12,6</Thickness>
    <Thickness x:Key="InputPadding">10,6</Thickness>
    <!--#endregion-->

    <!--#region Focus ring
         The old templates set FocusVisualStyle="{x:Null}" throughout, which left
         the app unusable by keyboard. This restores a visible 2px accent ring.
    -->
    <Style x:Key="FluxoFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="{DynamicResource RadiusMd}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="2"
                            Margin="-2"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region Roots
         Seeds font + foreground inheritance for the whole visual tree. Windows that
         set these explicitly still win, e.g. Dialogs/Widget/FloatingWidget.xaml.
    -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource ControlBackcolor}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForecolor}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style TargetType="{x:Type UserControl}">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    </Style>
    <!--#endregion-->

    <!--#region Text helpers -->
    <Style x:Key="CaptionText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <Style x:Key="SecondaryText" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <Style x:Key="TitleText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <!--#endregion-->

</ResourceDictionary>
