<!--
    Buttons.

    Hover/press feedback is done by fading a separate overlay Border rather than
    animating Background directly: the theme brushes are shared and frozen, so
    animating their Color would throw at runtime.

    MinHeight is 30 rather than the 32 a fresh design would use. Several inherited
    dialogs have fixed window heights and hand-placed rows, so the extra 7px over
    the old 23 is about as much as they absorb without clipping.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--#region Base template -->
    <ControlTemplate x:Key="FluxoButtonTemplate" TargetType="{x:Type ButtonBase}">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Bg"
                    CornerRadius="{DynamicResource RadiusMd}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"/>
            <Border x:Name="Overlay"
                    CornerRadius="{DynamicResource RadiusMd}"
                    Background="{DynamicResource ButtonMouseOverBackcolor}"
                    Opacity="0"/>
            <ContentPresenter x:Name="Content"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="True"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Overlay"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Overlay"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Overlay" Property="Background"
                        Value="{DynamicResource ButtonMousePressedBackcolor}"/>
                <Setter TargetName="Overlay" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{DynamicResource ButtonDisabledOpacity}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!--#endregion-->

    <!--#region Default (secondary) button -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FluxoFocusVisual}"/>
        <Setter Property="MinHeight" Value="30"/>
        <!-- Deliberately 0: several toolbar buttons are icon-only and use this
             implicit style, so a wide minimum would stretch them. Text buttons
             that want a dialog-sized footprint use DialogButton below. -->
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource ButtonBackcolor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonForecolor}"/>
        <Setter Property="Template" Value="{StaticResource FluxoButtonTemplate}"/>
    </Style>
    <!--#endregion-->

    <!--#region Accent (primary) button -->
    <Style x:Key="AccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bg"
                                CornerRadius="{DynamicResource RadiusMd}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="Overlay"
                                CornerRadius="{DynamicResource RadiusMd}"
                                Background="{DynamicResource AccentHoverBrush}"
                                Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Overlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Overlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background"
                                    Value="{DynamicResource AccentPressedBrush}"/>
                            <Setter TargetName="Overlay" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource ButtonDisabledOpacity}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region Ghost button
         Transparent until hovered - used for toolbar and status-bar commands.
    -->
    <Style x:Key="GhostButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource ToolButtonForecolor}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <Style x:Key="IconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Padding" Value="7"/>
    </Style>
    <!--#endregion-->

    <!--#region Dialog button
         Opt-in wider footprint for OK/Cancel style affirmative buttons.
    -->
    <Style x:Key="DialogButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="80"/>
    </Style>
    <!--#endregion-->

</ResourceDictionary>
