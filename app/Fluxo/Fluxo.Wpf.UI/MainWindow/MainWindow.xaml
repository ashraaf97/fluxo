<Window x:Class="Fluxo.Wpf.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fluxo.Wpf.UI"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        mc:Ignorable="d"
        Title="Fluxo" Height="500" Width="800" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Window.Resources>
        <!-- The Button style that used to be redeclared here was a byte-for-byte
             copy of the theme one. It now comes from Styles/Button.xaml.

             MenuItems no longer carry an explicit Foreground either - Styles/Menu.xaml
             finally gives MenuItem a real style, so they pick up the right colour
             on their own. -->

        <ContextMenu x:Key="ctxMainMenu" x:Name="ctxMainMenu"
                     LayoutUpdated="ctxMainMenu_LayoutUpdated">
            <MenuItem Name="menuSettings" Header="{StaticResource TITLE_SETTINGS}" Click="menuSettings_Click"/>
            <MenuItem Name="menuBrowserMonitor" Header="{StaticResource SETTINGS_MONITORING}" Click="menuBrowserMonitor_Click"/>
            <MenuItem Name="menuMediaGrabber" Header="{StaticResource MSG_MEDIA_CAPTURE}" Click="menuMediaGrabber_Click"/>
            <MenuItem Name="menuClearFinished" Header="{StaticResource MENU_DELETE_COMPLETED}" Click="menuClearFinished_Click"/>
            <MenuItem Name="menuExport" Header="{StaticResource MENU_EXPORT}" Click="menuExport_Click"/>
            <MenuItem Name="menuImport" Header="{StaticResource MENU_IMPORT}" Click="menuImport_Click"/>
            <Separator/>
            <MenuItem Name="menuHelpAndSupport" Header="{StaticResource LBL_SUPPORT_PAGE}" Click="menuHelpAndSupport_Click"/>
            <MenuItem Name="menuReportProblem" Header="{StaticResource LBL_REPORT_PROBLEM}" Click="menuReportProblem_Click"/>
            <MenuItem Name="menuCheckForUpdate" Header="{StaticResource MENU_UPDATE}" Click="menuCheckForUpdate_Click"/>
            <MenuItem Name="menuAbout" Header="{StaticResource MENU_ABOUT}" Click="menuAbout_Click"/>
            <Separator/>
            <MenuItem Name="menuExit" Header="{StaticResource MENU_EXIT}" Click="menuExit_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="lvInProgressContextMenu"></ContextMenu>
        <ContextMenu x:Key="lvFinishedContextMenu"></ContextMenu>
        <ControlTemplate x:Key="ToolbarButtonTemplate" TargetType="{x:Type Button}">
            <Border Name="Border" BorderBrush="{DynamicResource ToolButtonForecolor}" IsHitTestVisible="True" >
                <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" IsHitTestVisible="True">
                    <Path 
                                VerticalAlignment="Center" 
                                Margin="0,0,10,0"
                                StrokeThickness="0" 
                                Stretch="Uniform" 
                                Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, 
                        AncestorType=Border},Path=BorderBrush}"
                                Width="14" Height="14"  
                                Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor, 
                        AncestorType=Border},Path=BorderBrush}" 
                                Data="{TemplateBinding Tag}"
                                SnapsToDevicePixels="True"/>
                    <ContentPresenter 
                        VerticalAlignment="Center" 
                        x:Name="ContentSite" 
                        Margin="0,0,0,0" 
                        TextBlock.Foreground="{DynamicResource ToolButtonForecolor}"
                        TextBlock.FontSize="14">
                    </ContentPresenter>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource ToolButtonMouseOverBackcolor}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource ToolButtonMousePressedBackcolor}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ToolButtonMouseDisabledForecolor}" />
                    <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{DynamicResource ToolButtonMouseDisabledForecolor}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="ToolbarButtonTemplateIconOnly" TargetType="{x:Type Button}">
            <Border Name="Border" BorderBrush="{DynamicResource ToolButtonForecolor}" Background="Transparent" >
                <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" Background="Transparent">
                    <Path VerticalAlignment="Center" 
                          Margin="0,0,0,0"
                          StrokeThickness="0" 
                          Stretch="Fill" 
                          Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border},Path=BorderBrush}"
                          Width="14" Height="14"  
                          Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border},Path=BorderBrush}" 
                          Data="{TemplateBinding Tag}"
                          SnapsToDevicePixels="True"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource ToolButtonMouseOverBackcolor}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource ToolButtonMousePressedBackcolor}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ToolButtonMouseDisabledForecolor}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="ToolbarButtonTemplateIconOnlySmall" TargetType="{x:Type Button}" >
            <Border Name="Border" 
                    BorderBrush="{DynamicResource ToolButtonForecolor}" 
                    Background="{DynamicResource SearchBackcolor}" 
                    BorderThickness="0" 
                    >
                <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" Background="Transparent">
                    <Path 
                                VerticalAlignment="Center" 
                                Margin="0,0,0,0"
                                StrokeThickness="0" 
                                Stretch="Uniform" 
                                Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border},Path=BorderBrush}"
                                Width="14" Height="14"  
                                Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border},Path=BorderBrush}" 
                                Data="{TemplateBinding Tag}"
                                SnapsToDevicePixels="True"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource ToolButtonMouseOverBackcolor}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource ToolButtonMousePressedBackcolor}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ToolButtonMouseDisabledForecolor}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="MonitoringToggleButton" TargetType="{x:Type Button}">
            <Border Name="Border" BorderBrush="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" >
                <ContentPresenter 
                        VerticalAlignment="Center" 
                        x:Name="ContentSite" 
                        Margin="0,0,0,0" 
                        TextBlock.Foreground="{TemplateBinding Foreground}"
                        TextBlock.FontSize="14">
                </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource ToolButtonMouseOverBackcolor}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource ToolButtonMousePressedBackcolor}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ToolButtonMouseDisabledForecolor}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ContextMenu x:Key="newDownloadContextMenu">
            <MenuItem Name="menuNewDownload"/>
            <MenuItem Name="menuVideoDownload"/>
            <MenuItem Name="menuBatchDownload"/>
            <MenuItem Name="menuAddTorrent"/>
        </ContextMenu>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource ToolbarBordercolor}" 
            BorderThickness="{DynamicResource MainContentBorderThickness}" SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Sidebar is now user-resizable rather than pinned at 190px. -->
                <ColumnDefinition x:Name="SidebarColumn" Width="200" MinWidth="150" MaxWidth="360"/>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <ListBox BorderThickness="{DynamicResource CategoryListBorderThickness}"
                 Name="lvCategory"
                 SelectionChanged="lvCategory_SelectionChanged"
                 BorderBrush="{DynamicResource ToolbarBordercolor}"
                 Background="{DynamicResource CategoryListBackground}" >
                <ListBox.Resources>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Border x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    Tag="{DynamicResource CategoryForegroundNormal}"
                                    SnapsToDevicePixels="true">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Border>
                                    <!-- Hover comes before selection, and selected+hovered
                                         comes last. With hover declared after IsSelected
                                         it won outright, so moving the pointer over the
                                         selected category replaced its accent tint with
                                         the plain hover grey and it looked deselected. -->
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource CategoryMouseOverBackground}" />
                                            <Setter Property="Tag" TargetName="Bd" Value="{DynamicResource CategoryForegroundSelected}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource CategoryHighlight}" />
                                            <Setter Property="Tag" TargetName="Bd" Value="{DynamicResource CategoryForegroundSelected}" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource CategorySelectedHoverBackground}" />
                                            <Setter Property="Tag" TargetName="Bd" Value="{DynamicResource CategoryForegroundSelected}" />
                                        </MultiTrigger>
                                        <!--<MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Selector.IsSelectionActive" Value="False" />
                                                <Condition Property="IsSelected" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource CategoryHighlight}" />
                                            <Setter Property="Tag" TargetName="Bd" Value="{DynamicResource CategoryForegroundSelected}" />
                                        </MultiTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Selector.IsSelectionActive"
                                            Value="True" />
                                                <Condition Property="IsSelected"
                                            Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource CategoryHighlight}" />
                                            <Setter Property="Tag" TargetName="Bd" Value="{DynamicResource CategoryForegroundSelected}" />
                                        </MultiTrigger>-->
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel x:Name="CategoryItem" IsHitTestVisible="True" Margin="0,0">
                            <!-- Icon column is Auto, not a second star column. With two
                                 star columns the label only ever got half the 190px
                                 sidebar and longer categories were clipped mid-word. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"
                                StrokeThickness="0"
                                Stretch="Uniform"
                                Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border},Path=Tag}"
                                Width="18" Height="18"  Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border},Path=Tag}"
                                Data="{Binding Path=VectorIcon,
                                Converter={StaticResource CategoryToVectorImageConverter}}"
                                SnapsToDevicePixels="True"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border},Path=Tag}" />
                            </Grid>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Path=IsTopLevel}" Value="True">
                                <Setter TargetName="CategoryItem" Property="Margin" Value="10,5,10,5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=IsTopLevel}" Value="False">
                                <Setter TargetName="CategoryItem" Property="Margin" Value="25,5,10,5" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Straddles the column boundary; transparent so only the sidebar's
                 own right-hand border is visible. -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          Margin="-3,0,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Panel.ZIndex="10"
                          Focusable="False"/>

            <DockPanel Grid.Column="1">
                <Border  DockPanel.Dock="Top" 
                     Background="{DynamicResource ControlBackcolor}" 
                     BorderThickness="0,0,0,1" 
                     BorderBrush="{DynamicResource ToolbarBordercolor}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Commands are Auto so they are never truncated; the search
                                 field takes what is left and shrinks first. The reverse
                                 (commands starred, search Auto) let the search box win
                                 the space and clip "Open folder" mid-word. -->
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0,0,0"
                                    ClipToBounds="True">
                            <!-- New is the primary action, so it gets the accent
                                 treatment; the rest stay ghost buttons. -->
                            <Button
                                Style="{StaticResource AccentButton}"
                                Margin="0,8,8,8"
                                Padding="12,6"
                                Name="BtnNew">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        VerticalAlignment="Center"  Margin="0,0,8,0" Width="14" Height="14" Stretch="Uniform" StrokeThickness="0"
                                        Fill="{DynamicResource OnAccentBrush}" Stroke="{DynamicResource OnAccentBrush}"
                                        Data="{StaticResource ri-links-line}" SnapsToDevicePixels="True"/>
                                    <TextBlock Foreground="{DynamicResource OnAccentBrush}" Text="{StaticResource DESC_NEW}"/>
                                </StackPanel>
                            </Button>

                            <Button 
                                Style="{StaticResource GhostButton}"
                                Margin="0,8,4,8"
                                Padding="10,6"

                                Name="BtnDelete">
                                <StackPanel Orientation="Horizontal">
                                    <Path 
                                        VerticalAlignment="Center"  Margin="0,0,10,0" Width="14" Height="14" Stretch="Uniform" StrokeThickness="0"
                                        Fill="{DynamicResource ToolButtonForecolor}" Stroke="{DynamicResource ToolButtonForecolor}"  SnapsToDevicePixels="True"
                                        Data="{StaticResource ri-delete-bin-line}"/>
                                    <TextBlock Foreground="{DynamicResource ToolButtonForecolor}" Text="{StaticResource DESC_DEL}"/>
                                </StackPanel>
                            </Button>
                            <!--<Button Template="{StaticResource ToolbarButtonTemplate}" 
                            Padding="12,12" 
                            IsEnabled="False" 
                            Tag="{StaticResource ri-delete-bin-line}"
                            Name="BtnDelete">
                                Delete
                            </Button>-->
                            <!--<Button Template="{StaticResource ToolbarButtonTemplate}" 
                            Padding="12,12"   
                            IsEnabled="False" 
                            Tag="{StaticResource ri-mail-open-line}"
                            Name="BtnOpen">
                                Open
                            </Button>
                            <Button Template="{StaticResource ToolbarButtonTemplate}" 
                            Padding="12,10"  
                            IsEnabled="False" 
                            Tag="{StaticResource ri-folder-shared-line}"
                            Name="BtnOpenFolder">
                                Open folder
                            </Button>
                            <Button Template="{StaticResource ToolbarButtonTemplate}" 
                            Padding="12,10" 
                            IsEnabled="False" 
                            Tag="{StaticResource ri-pause-line}" 
                            Name="BtnPause">
                                Pause
                            </Button>
                            <Button Template="{StaticResource ToolbarButtonTemplate}" 
                            Padding="12,10" 
                            IsEnabled="False" 
                            Tag="{StaticResource ri-play-line}"
                            Name="BtnResume"
                            >
                                Resume
                            </Button>-->
                            <Button 
                                Visibility="Collapsed"
                                Style="{StaticResource GhostButton}"
                                Margin="0,8,4,8"
                                Padding="10,6"

                                Name="BtnOpen">
                                <StackPanel Orientation="Horizontal">
                                    <Path 
                                        VerticalAlignment="Center"  Margin="0,0,10,0" Width="14" Height="14" Stretch="Uniform" StrokeThickness="0"
                                        Fill="{DynamicResource ToolButtonForecolor}" Stroke="{DynamicResource ToolButtonForecolor}"  SnapsToDevicePixels="True"
                                        Data="{StaticResource ri-mail-open-line}"/>
                                    <TextBlock Foreground="{DynamicResource ToolButtonForecolor}" Text="{StaticResource CTX_OPEN_FILE}"/>
                                </StackPanel>
                            </Button>
                            <Button 
                                Style="{StaticResource GhostButton}"
                                Margin="0,8,4,8"
                                Padding="10,6"

                                Name="BtnOpenFolder">
                                <StackPanel Orientation="Horizontal">
                                    <Path 
                                        VerticalAlignment="Center"  Margin="0,0,10,0" Width="14" Height="14" Stretch="Uniform" StrokeThickness="0"
                                        Fill="{DynamicResource ToolButtonForecolor}" Stroke="{DynamicResource ToolButtonForecolor}"  SnapsToDevicePixels="True"
                                        Data="{StaticResource ri-folder-shared-line}"/>
                                    <TextBlock Foreground="{DynamicResource ToolButtonForecolor}" Text="{StaticResource CTX_OPEN_FOLDER}"/>
                                </StackPanel>
                            </Button>
                            <Button 
                                Style="{StaticResource GhostButton}"
                                Margin="0,8,4,8"
                                Padding="10,6"

                                Name="BtnPause">
                                <StackPanel Orientation="Horizontal">
                                    <Path 
                                        VerticalAlignment="Center"  Margin="0,0,10,0" Width="14" Height="14" Stretch="Uniform" StrokeThickness="0"
                                        Fill="{DynamicResource ToolButtonForecolor}" Stroke="{DynamicResource ToolButtonForecolor}"  SnapsToDevicePixels="True"
                                        Data="{StaticResource ri-pause-line}"/>
                                    <TextBlock Foreground="{DynamicResource ToolButtonForecolor}" Text="{StaticResource MENU_PAUSE}"/>
                                </StackPanel>
                            </Button>
                            <Button 
                                Style="{StaticResource GhostButton}"
                                Margin="0,8,4,8"
                                Padding="10,6"

                                Name="BtnResume">
                                <StackPanel Orientation="Horizontal">
                                    <Path 
                                        VerticalAlignment="Center"  Margin="0,0,10,0" Width="14" Height="14" Stretch="Uniform" StrokeThickness="0"
                                        Fill="{DynamicResource ToolButtonForecolor}" Stroke="{DynamicResource ToolButtonForecolor}"  SnapsToDevicePixels="True"
                                        Data="{StaticResource ri-play-line}"/>
                                    <TextBlock Foreground="{DynamicResource ToolButtonForecolor}" Text="{StaticResource MENU_RESUME}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- Leading icon, then the field, then nothing. The previous
                             markup put the TextBox and the search Button in two
                             star-width columns and pinned the box to Width="100",
                             so the two overlapped as the toolbar resized. -->
                        <Border Grid.Column="1" Margin="12,8,0,8" VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                MinWidth="150" MaxWidth="280"
                                CornerRadius="{DynamicResource RadiusMd}"
                                Background="{DynamicResource SearchBackcolor}"
                                BorderBrush="{DynamicResource SearchBorder}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Path Grid.Column="0" VerticalAlignment="Center"
                                      Margin="10,0,6,0" Width="14" Height="14" Stretch="Uniform"
                                      StrokeThickness="0"
                                      Fill="{DynamicResource PlaceHolderForecolor}"
                                      Stroke="{DynamicResource PlaceHolderForecolor}"
                                      SnapsToDevicePixels="True"
                                      Data="{StaticResource ri-search-line}"/>

                                <!-- Filters as you type. There used to be a separate
                                     search button and no TextChanged handler, so typing
                                     a query did nothing until you clicked it. -->
                                <TextBox Grid.Column="1" Name="TxtSearch" AcceptsReturn="False"
                                         TextWrapping="NoWrap" VerticalContentAlignment="Center"
                                         MinHeight="0" Padding="0,4" Margin="0,0,10,0"
                                         BorderThickness="0" Background="Transparent"
                                         TextChanged="TxtSearch_TextChanged"
                                         Foreground="{DynamicResource TextForecolor}"/>

                                <TextBlock Grid.Column="1" x:Name="Placeholder" IsHitTestVisible="False"
                                           TextWrapping="NoWrap" Text="{StaticResource LBL_SEARCH}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PlaceHolderForecolor}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsFocused, ElementName=TxtSearch}" Value="false" />
                                                        <Condition Binding="{Binding Text, ElementName=TxtSearch}" Value="" />
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.Setters>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger.Setters>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Button Name="BtnMenu" Grid.Column="2" Style="{StaticResource IconButton}"
                                Padding="9" Margin="6,8,8,8"
                                Click="BtnMenu_Click">
                            <Path VerticalAlignment="Center" Width="16" Height="16"  Margin="0,0,0,0" Stretch="Uniform" 
                                  StrokeThickness="0" Fill="{DynamicResource ToolButtonForecolor}" 
                                  Stroke="{DynamicResource ToolButtonForecolor}"  SnapsToDevicePixels="True"
                                  Data="{StaticResource  ri-menu-line}"/>
                        </Button>
                    </Grid>
                </Border>
                <Border BorderThickness="0,1,0,0" 
                    BorderBrush="{DynamicResource ToolbarBordercolor}" 
                    DockPanel.Dock="Bottom" 
                    Background="{DynamicResource StatusbarBackcolor}"
                    SnapsToDevicePixels="True"
                    Padding="5,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Padding="10,0,7,2" 
                               Foreground="{DynamicResource ToolButtonForecolor}" 
                               Background="{DynamicResource StatusbarBackcolor}"
                               VerticalAlignment="Center" Text="{StaticResource SETTINGS_MONITORING}"/>
                        <Button Grid.Column="1"  Name="BtnMonitoring" Foreground="{DynamicResource ToolButtonForecolor}"
                            Margin="0" Padding="0" BorderThickness="0" Background="{DynamicResource StatusbarBackcolor}"
                            Click="BtnMonitoring_Click">
                            <Path Name="MonitoringToggleIcon"
                                Height="24"
                                Width="24"
                                Margin="5,0"
                                VerticalAlignment="Center" 
                                StrokeThickness="0"
                                Stretch="None" 
                                Fill="{DynamicResource StatusbarIconcolor}"
                                Stroke="{DynamicResource StatusbarIconcolor}" 
                                Data="{StaticResource ri-toggle-line}"
                                SnapsToDevicePixels="True">
                            </Path>
                        </Button>
                        <Button Grid.Column="2" Name="BtnQueue" Foreground="{DynamicResource ToolButtonForecolor}"
                            Margin="10,0" Padding="0" BorderThickness="0" Background="{DynamicResource StatusbarBackcolor}"
                                Click="BtnQueue_Click">
                            <StackPanel Orientation="Horizontal" Margin="5,0,10,0">
                                <Path
                                Height="14"
                                Width="14"
                                Margin="5,0"
                                VerticalAlignment="Center" 
                                StrokeThickness="0"
                                Stretch="Fill" 
                                Fill="{DynamicResource StatusbarIconcolor}"
                                Stroke="{DynamicResource StatusbarIconcolor}" 
                                Data="{StaticResource ri-list-settings-fill}"
                                SnapsToDevicePixels="True"/>
                                <TextBlock Padding="3,0,3,2" VerticalAlignment="Center" Text="{StaticResource DESC_Q_TITLE}"/>
                            </StackPanel>
                        </Button>
                        <Button Name="BtnHelp" Grid.Column="4" Foreground="{DynamicResource ToolButtonForecolor}"
                            Margin="0,0" Padding="0" BorderThickness="0" Background="{DynamicResource StatusbarBackcolor}" Click="BtnHelp_Click">
                            <StackPanel Orientation="Horizontal" Margin="5,0,10,0">
                                <Path Name="PathHelp"
                                    Height="16"
                                    Width="16"
                                    Margin="5,0"
                                    VerticalAlignment="Center" 
                                    StrokeThickness="0"
                                    Stretch="Fill" 
                                    Fill="{DynamicResource StatusbarIconcolor}"
                                    Stroke="{DynamicResource StatusbarIconcolor}" 
                                    Data="{StaticResource ri-question-line}"
                                    SnapsToDevicePixels="True"/>
                                <TextBlock Padding="3,0,3,2" VerticalAlignment="Center" Name="TxtHelp" Text="{StaticResource LBL_SUPPORT_PAGE}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListView Name="lvInProgress"
                              BorderThickness="0"
                          VerticalContentAlignment="Stretch" 
                          HorizontalAlignment="Stretch" 
                          Grid.Column="0" Grid.Row="0"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          GridViewColumnHeader.Click="lvInProgress_Click">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="235">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Tag="Name">
                                            <TextBlock Padding="34,0,0,0" Text="{StaticResource SORT_NAME}" />
                                        </GridViewColumnHeader>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Torrents render as a header row with their files
                                                 nested underneath. RowIndent shifts members across;
                                                 the chevron only appears on headers. -->
                                            <StackPanel Orientation="Horizontal" Margin="{Binding RowIndent}">
                                                <Button Style="{StaticResource IconButton}"
                                                        Padding="2" Margin="0,0,2,0" MinHeight="0"
                                                        Visibility="{Binding ExpanderVisibility}"
                                                        Click="GroupExpander_Click"
                                                        Focusable="False">
                                                    <TextBlock Text="{Binding ExpanderGlyph}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                </Button>
                                                <!-- Tinted per file type via FileExtensionToColorConverter.
                                                     The converter already existed but the list painted
                                                     every icon the same flat grey. -->
                                                <Path SnapsToDevicePixels="True"
                                                  VerticalAlignment="Center" Margin="0,0,10,0" StrokeThickness="0" Stretch="Uniform"
                                                  Fill="{Binding Path=FileIconText, Converter={StaticResource VectorNameToColorConverter}}"
                                                  Width="20" Height="20"
                                                  Data="{Binding Path=FileIconText, Converter={StaticResource VectorNameToGeometryConverter}}"
                                                  />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                           FontWeight="{Binding RowWeight}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="85" x:Name="p1">
                                    <GridViewColumn.Header>
                                        <!-- Literal, as before: there is no translation
                                             key for "progress" and "%" needs none. -->
                                        <GridViewColumnHeader Tag="Progress">
                                            <TextBlock Text="%"/>
                                        </GridViewColumnHeader>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Bar plus the percentage beside it. The old cell was a
                                                 bare 5px bar in a 50px column with no readout. -->
                                            <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0"
                                                             Value="{Binding Progress}"
                                                             Maximum="100"
                                                             Height="6"
                                                             VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                                           MinWidth="34" TextAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           Text="{Binding Progress, StringFormat={}{0}%}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="68">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Tag="Size">
                                            <TextBlock Text="{StaticResource SORT_SIZE}"/>
                                        </GridViewColumnHeader>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Size, Converter={StaticResource FileSizeValueConverter}}"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!-- Carries speed and ETA, e.g. "2.1 MB/s, 00:02:54 left". -->
                                <GridViewColumn Width="105">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Tag="Status">
                                            <TextBlock Text="{StaticResource SORT_STATUS}"/>
                                        </GridViewColumnHeader>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="68">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Tag="DateAdded" Name="lvInProgress_DateAdded">
                                            <TextBlock Text="{StaticResource SORT_DATE}"/>
                                        </GridViewColumnHeader>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DateAdded, StringFormat=d}"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="ContextMenu" Value="{StaticResource lvInProgressContextMenu}" />
                                <Setter Property="Padding" Value="0,0" />
                                <EventSetter Event="MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <ListView Name="lvFinished"  
                          VerticalContentAlignment="Stretch" 
                              BorderThickness="0"
                          HorizontalAlignment="Stretch" 
                          Grid.Column="0" Grid.Row="0"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          GridViewColumnHeader.Click="lvFinished_Click">
                        <!--<ListView.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <ResourceDictionary Source="Resources/MainListViewStyles.xaml"/>
                                </ResourceDictionary.MergedDictionaries>
                            </ResourceDictionary>
                        </ListView.Resources>-->
                        <ListView.View>
                            <GridView>
                                <GridViewColumn  Width="300" >
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Tag="Name">
                                            <TextBlock Padding="34,0,0,0" Text="{StaticResource SORT_NAME}"/>
                                        </GridViewColumnHeader>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Path SnapsToDevicePixels="True" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" StrokeThickness="0" Stretch="Uniform"
                                                      Fill="{Binding Path=Name, Converter={StaticResource FileExtensionToColorConverter}}"
                                                  Width="20" Height="20"
                                                  Data="{Binding Path=Name, Converter={StaticResource FileExtensionToVectorImageConverter}}"
                                                  />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="90">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Tag="Size">
                                            <TextBlock Text="{StaticResource SORT_SIZE}"/>
                                        </GridViewColumnHeader>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Size, Converter={StaticResource FileSizeValueConverter}}"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="90">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Tag="DateAdded" Name="lvFinished_DateAdded">
                                            <TextBlock Text="{StaticResource SORT_DATE}"/>
                                        </GridViewColumnHeader>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DateAdded, StringFormat=d}"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="ContextMenu" Value="{StaticResource lvFinishedContextMenu}" />
                                <Setter Property="Padding" Value="0,0" />
                                <EventSetter Event="MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <!-- Empty state. Sits on top of both lists and shows only when the
                         list currently on screen has nothing in it, so it never covers
                         the hidden one. Driven entirely by triggers - no code-behind. -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Visibility, ElementName=lvInProgress}" Value="Visible"/>
                                            <Condition Binding="{Binding HasItems, ElementName=lvInProgress}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Visibility, ElementName=lvFinished}" Value="Visible"/>
                                            <Condition Binding="{Binding HasItems, ElementName=lvFinished}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Height="64" Width="64"
                              HorizontalAlignment="Center"
                              StrokeThickness="0"
                              Stretch="Uniform"
                              Opacity="0.35"
                              Fill="{DynamicResource TextTertiary}"
                              Stroke="{DynamicResource TextTertiary}"
                              Data="{StaticResource ri-folder-download-line}"
                              SnapsToDevicePixels="True"/>
                        <TextBlock Margin="0,16,0,0"
                                   TextAlignment="Center"
                                   FontSize="{DynamicResource FontSizeSubtitle}"
                                   Foreground="{DynamicResource TextTertiary}"
                                   Text="{StaticResource MSG_NO_DOWNLOADS}"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
