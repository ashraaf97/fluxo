<Window x:Class="Fluxo.Wpf.UI.Dialogs.Settings.RssRuleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fluxo.Wpf.UI.Dialogs.Settings"
        mc:Ignorable="d"
        Title="{StaticResource RSS_RULE_TITLE}" Height="520" Width="480"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{StaticResource LBL_RSS_RULE_NAME}" Margin="0,0,0,3"/>
            <TextBox Name="TxtName" Grid.Row="1" Margin="0,0,0,8" VerticalContentAlignment="Center"
                     AcceptsReturn="False" TextWrapping="NoWrap" Padding="5"/>

            <TextBlock Grid.Row="2" Text="{StaticResource LBL_RSS_MUST_CONTAIN}" Margin="0,0,0,3"/>
            <TextBox Name="TxtMustContain" Grid.Row="3" Margin="0,0,0,4" VerticalContentAlignment="Center"
                     AcceptsReturn="False" TextWrapping="NoWrap" Padding="5"/>
            <TextBlock Grid.Row="4" Text="{StaticResource LBL_RSS_MUST_NOT_CONTAIN}" Margin="0,0,0,3"/>
            <TextBox Name="TxtMustNotContain" Grid.Row="5" Margin="0,0,0,4" VerticalContentAlignment="Center"
                     AcceptsReturn="False" TextWrapping="NoWrap" Padding="5"/>
            <TextBlock Grid.Row="6" Text="{StaticResource MSG_RSS_EXPRESSION_HINT}" Opacity="0.75"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>

            <CheckBox Name="ChkUseRegex" Grid.Row="7" Content="{StaticResource CHK_RSS_USE_REGEX}"
                      VerticalContentAlignment="Center" Padding="3" Margin="0,0,0,4"/>
            <CheckBox Name="ChkSmartFilter" Grid.Row="8" Content="{StaticResource CHK_RSS_SMART_FILTER}"
                      VerticalContentAlignment="Center" Padding="3" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="9" Text="{StaticResource LBL_RSS_IGNORE_DAYS}" Margin="0,0,0,3"/>
            <TextBox Name="TxtIgnoreDays" Grid.Row="10" Margin="0,0,0,8" Width="100"
                     HorizontalAlignment="Left" VerticalContentAlignment="Center" Padding="5"/>

            <TextBlock Grid.Row="11" Text="{StaticResource LBL_RSS_PRIORITY}" Margin="0,0,0,3"/>
            <TextBox Name="TxtPriority" Grid.Row="12" Margin="0,0,0,8" Width="100"
                     HorizontalAlignment="Left" VerticalContentAlignment="Center" Padding="5"/>

            <TextBlock Grid.Row="13" Text="{StaticResource LBL_RSS_SAVE_FOLDER}" Margin="0,0,0,3"/>
            <Grid Grid.Row="14" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="TxtSaveFolder" Grid.Column="0" VerticalContentAlignment="Center"
                         AcceptsReturn="False" TextWrapping="NoWrap" Padding="5"/>
                <Button Name="BtnBrowse" Grid.Column="1" Margin="8,0,0,0" Padding="8,3"
                        Content="..." Click="BtnBrowse_Click"/>
            </Grid>

            <StackPanel Grid.Row="15" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Name="BtnOk" Content="{StaticResource MSG_OK}" Padding="25,3" Click="BtnOk_Click"/>
                <Button Name="BtnCancel" Content="{StaticResource ND_CANCEL}" Margin="10,0,0,0" Padding="15,3" Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>