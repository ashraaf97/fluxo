<UserControl x:Class="Fluxo.Wpf.UI.Dialogs.Settings.RssSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Fluxo.Wpf.UI.Dialogs.Settings"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,18,10,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,10,10,0"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Margin" Value="10,4,10,0"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Margin" Value="10,6,10,0"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <TextBlock Padding="10" Text="{StaticResource SETTINGS_RSS}" FontSize="14" DockPanel.Dock="Top"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Margin="10,5,10,0" TextWrapping="Wrap" Opacity="0.75"
                           Text="{StaticResource MSG_RSS_INTRO}"/>

                <!-- General -->
                <CheckBox Name="ChkEnabled" Style="{StaticResource Check}" Content="{StaticResource CHK_RSS_ENABLED}"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{StaticResource LBL_RSS_REFRESH}"/>
                <TextBox Name="TxtRefreshMinutes" Style="{StaticResource FieldBox}"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{StaticResource LBL_RSS_MAX_ARTICLES}"/>
                <TextBox Name="TxtMaxArticles" Style="{StaticResource FieldBox}" Margin="10,4,10,16"/>

                <TextBlock Margin="10,0,10,8" TextWrapping="Wrap" Opacity="0.75"
                           Text="{StaticResource MSG_RSS_NEEDS_DEBRID}"/>

                <!-- Feeds -->
                <TextBlock Style="{StaticResource SectionHead}" Text="{StaticResource LBL_RSS_FEEDS}"/>
                <ListView Name="LvFeeds" Margin="10,4" Height="140" BorderThickness="1"
                          BorderBrush="{DynamicResource ControlBordercolor}"
                          SelectionChanged="LvFeeds_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{StaticResource LBL_RSS_FEED_NAME}" Width="160"
                                            DisplayMemberBinding="{Binding DisplayName}"/>
                            <GridViewColumn Header="{StaticResource LBL_RSS_FEED_URL}" Width="320"
                                            DisplayMemberBinding="{Binding Url}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Margin="10,0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Name="BtnFeedAdd" Margin="0,0,5,0" Padding="10,3"
                            Content="{StaticResource SETTINGS_CAT_ADD}" Click="BtnFeedAdd_Click"/>
                    <Button Name="BtnFeedEdit" Margin="5,0,5,0" Padding="10,3"
                            Content="{StaticResource SETTINGS_CAT_EDIT}" Click="BtnFeedEdit_Click"/>
                    <Button Name="BtnFeedDelete" Margin="5,0,5,0" Padding="10,3"
                            Content="{StaticResource DESC_DEL}" Click="BtnFeedDelete_Click"/>
                    <Button Name="BtnFeedRefresh" Margin="5,0,0,0" Padding="10,3"
                            Content="{StaticResource MSG_RSS_REFRESH_NOW}" Click="BtnFeedRefresh_Click"/>
                </StackPanel>

                <!-- Rules -->
                <TextBlock Style="{StaticResource SectionHead}" Text="{StaticResource LBL_RSS_RULES}"/>
                <ListView Name="LvRules" Margin="10,4" Height="140" BorderThickness="1"
                          BorderBrush="{DynamicResource ControlBordercolor}"
                          SelectionChanged="LvRules_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{StaticResource LBL_RSS_RULE_NAME}" Width="160"
                                            DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="{StaticResource LBL_RSS_MUST_CONTAIN}" Width="160"
                                            DisplayMemberBinding="{Binding MustContain}"/>
                            <GridViewColumn Header="{StaticResource LBL_RSS_PRIORITY}" Width="80"
                                            DisplayMemberBinding="{Binding Priority}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Margin="10,0,10,16" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Name="BtnRuleAdd" Margin="0,0,5,0" Padding="10,3"
                            Content="{StaticResource SETTINGS_CAT_ADD}" Click="BtnRuleAdd_Click"/>
                    <Button Name="BtnRuleEdit" Margin="5,0,5,0" Padding="10,3"
                            Content="{StaticResource SETTINGS_CAT_EDIT}" Click="BtnRuleEdit_Click"/>
                    <Button Name="BtnRuleDelete" Margin="5,0,0,0" Padding="10,3"
                            Content="{StaticResource DESC_DEL}" Click="BtnRuleDelete_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>