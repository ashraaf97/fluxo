#!/bin/bash

#Please place all the published files under ./binary-source directory

VERSION=8.0.26
SRC_DIR=binary-source
SOURCE_NAME="src"

rm -rf "${SOURCE_NAME}"
rm -rf pkg
rm -rf src
rm -f "${SOURCE_NAME}*pkg.tar.*"
rm -f PKGBUILD

mkdir "${SOURCE_NAME}"
mkdir -p "${SOURCE_NAME}/opt/fluxo"
mkdir -p "${SOURCE_NAME}/usr/bin"
mkdir -p "${SOURCE_NAME}/usr/share/applications"

cp -r "${SRC_DIR}/." "${SOURCE_NAME}/opt/fluxo"

find "${SOURCE_NAME}/" -type d -print0 | xargs -0 chmod 0755
find "${SOURCE_NAME}/" -type f -print0 | xargs -0 chmod 0644

touch "${SOURCE_NAME}/opt/fluxo/fluxo-app.desktop"
touch "${SOURCE_NAME}/usr/bin/fluxo"

cat <<EOF > "${SOURCE_NAME}/opt/fluxo/fluxo-app.desktop"
[Desktop Entry]
Version=1.0
Encoding=UTF-8
Exec=env GTK_USE_PORTAL=1 /opt/fluxo/fluxo-app %U
Type=Application
Terminal=false
Name=Fluxo
Comment=Fluxo
Categories=Network;
Icon=/opt/fluxo/fluxo-logo.svg
MimeType=application/fluxo-app;x-scheme-handler/fluxo-app;
StartupNotify=true
EOF

cat <<EOF > "${SOURCE_NAME}/usr/bin/fluxo"
#!/bin/bash
export GTK_USE_PORTAL=1 
/opt/fluxo/fluxo-app \$@
EOF

cat <<EOF > "${SOURCE_NAME}/opt/fluxo/source_pkg.txt"
fluxo_gtk|.pkg.tar.zst;.pkg.tar.xz;.pkg.tar.gz;.pkg.tar.bz2
EOF

cp "${SOURCE_NAME}/opt/fluxo/fluxo-app.desktop" "${SOURCE_NAME}/usr/share/applications"

chmod 755 "${SOURCE_NAME}/usr/bin/fluxo"
chmod 755 "${SOURCE_NAME}/opt/fluxo/fluxo-app"
# Fluxo.App.Host is a Windows only project, so it is absent from a plain GTK
# publish. Only chmod it when it has actually been staged.
[ -f "${SOURCE_NAME}/opt/fluxo/Fluxo.App.Host/fluxo-app-host" ] && chmod 755 "${SOURCE_NAME}/opt/fluxo/Fluxo.App.Host/fluxo-app-host"

#tar --create --file "${SOURCE_NAME}.tar.gz" -C "${SOURCE_NAME}" .

cat <<EOF > "PKGBUILD"
pkgname=fluxo_gtk
pkgver=${VERSION}
pkgrel=1
pkgdesc="Open source download accelerator and video downloader."
arch=("x86_64")
url="https://github.com/ashraaf97/fluxo"
license=('GPLv3')
#source=("${SOURCE_NAME}.tar.gz")
depends=('ffmpeg' 'gtk3>=3.22.0')
#sha1sums=('SKIP')

package() {
	cp -r * \$pkgdir
}
EOF

cat PKGBUILD

makepkg -d -f