<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>

    <!-- Matches the other projects. Without it every nullable annotation in the
         shared Fluxo.Core sources raises CS8632 here. -->
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>

  <Import Project="..\Fluxo.Core\Fluxo.Core.projitems" Label="Shared" />
  <Import Project="..\Fluxo.Messaging\Fluxo.Messaging.projitems" Label="Shared" />
  <Import Project="..\Fluxo.Compatibility\Fluxo.Compatibility.projitems" Label="Shared" />

</Project>
